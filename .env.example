# Strava API app (strava.com/settings/api)
NUXT_STRAVA_CLIENT_ID=
NUXT_STRAVA_CLIENT_SECRET=
# Refresh token with the activity:read scope, from the one-time authorization. Only used until Neon holds a newer one.
NUXT_STRAVA_REFRESH_TOKEN=
# Neon connection string; the database stores the latest Strava refresh token (see server/db/strava-token.sql)
NUXT_DATABASE_URL=
